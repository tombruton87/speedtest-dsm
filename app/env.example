# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8780
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:8780
SSL_PROXY=0
FORCE_HTTPS=false                    # true behind DSM's reverse proxy with HTTPS
ST_IMAGE=lscr.io/linuxserver/speedtest-tracker:latest
APP_KEY=base64:…                     # protects stored secrets; kept in every backup
ADMIN_EMAIL=you@example.com          # your account (the password is never stored; it's shown once)
ADMIN_NAME=Your+Name
EVERY=6h                             # 1h | 3h | 6h | 12h | 24h | off — the window's choice
SPEEDTEST_SCHEDULE="17 */6 * * *"    # …as the cron Speedtest Tracker reads
SPEEDTEST_SERVERS=                   # an Ookla server id, or empty for the nearest
KEEP_DAYS=0                          # results older than this are removed; 0 keeps them all
PUBLIC_DASHBOARD=false               # true: the dashboard is readable without signing in
DSM_ALERTS=1                         # a DSM notification when a result misses the thresholds or a test fails
TLS=off                              # dsm | self | off — HTTPS served by the container's own nginx
TLS_SOURCE=off
INNER_PORT=80                        # 443 when HTTPS is on
